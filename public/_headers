# Cloudflare static assets serve .txt as bare "text/plain"; add the charset
# so llms.txt (and robots.txt) are read as UTF-8.
/llms.txt
  Content-Type: text/plain; charset=utf-8

# Same content as the homepage; keep the copy out of search results.
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex

/robots.txt
  Content-Type: text/plain; charset=utf-8
